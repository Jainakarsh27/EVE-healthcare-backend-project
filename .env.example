# Application Settings
PROJECT_NAME="EVE Healthcare Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://eve_user:eve_password@localhost:5432/eve_healthcare_db"
# Sync Database URL for Alembic migrations if needed
SYNC_DATABASE_URL="postgresql+psycopg2://eve_user:eve_password@localhost:5432/eve_healthcare_db"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & JWT Configuration
# Generate secure key using: openssl rand -hex 32
JWT_SECRET_KEY="eve-healthcare-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Webhook Security
WEBHOOK_SECRET="whsec_eve_healthcare_mock_webhook_secret_key_2026"

# Seed Credentials
SEED_ADMIN_EMAIL="admin@evehealthcare.com"
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_USER_EMAIL="user@evehealthcare.com"
SEED_USER_PASSWORD="UserPassword123!"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"
